# Yo! Payments + payment mesh secrets (SERVER ONLY — never commit).
# Install on us1/Edge at /opt/salt-secrets/payments.env (chmod 600) and pass it
# to the supabase-api container with:
#   --env-file /opt/salt-secrets/payments.env
#
# Do NOT put these in the repo or bake them into the Docker image.

YO_API_URL=https://paymentsapi2.yo.co.ug/ybs/task.php
YO_API_USERNAME=REPLACE_WITH_YO_API_USERNAME
YO_API_PASSWORD=REPLACE_WITH_YO_API_PASSWORD

# Dedicated Yo! KYC API/credentials (sandbox endpoint per Yo! support).
# Payments/status keep using YO_API_* above; only KYC uses these.
YO_KYC_API_URL=https://paymentsdev1.yo.co.ug/yopaytest/task.php
YO_KYC_API_USERNAME=REPLACE_WITH_YO_KYC_USERNAME
YO_KYC_API_PASSWORD=REPLACE_WITH_YO_KYC_PASSWORD
# YO_KYC_CACHE_TTL_SECONDS=600

# MTN MoMo collection API (new app path; old app keeps Firebase->Directus).
MTN_MOMO_ENV=mtnuganda
MTN_MOMO_SUBSCRIPTION_KEY=REPLACE_WITH_MTN_SUBSCRIPTION_KEY
MTN_MOMO_API_USER=REPLACE_WITH_MTN_API_USER
MTN_MOMO_API_KEY=REPLACE_WITH_MTN_API_KEY
# Active MoMo callback: mesh. The legacy Directus flow is kept commented for
# cutover/legacy app only. The MTN dashboard default can stay on the CMS URL;
# the per-request X-Callback-Url overrides it for new-app payments.
MOMO_CALLBACK_URL=https://edge.solofx.net/api/v1/momoCallback
# MOMO_CALLBACK_URL=https://cms.salttelevision.com/flows/trigger/301f83da-4306-456d-a614-d476ff422b66

# Keep the Firebase webhook URLs until the old app is retired.
YO_IPN_URL=https://us-central1-salt-media-app1.cloudfunctions.net/yoWebhooks/yo-ipn
YO_FAILURE_URL=https://us-central1-salt-media-app1.cloudfunctions.net/yoWebhooks/yo-failure

# Future mesh cutover: comment the two Firebase lines above, then uncomment
# these two.
# YO_IPN_URL=https://edge.solofx.net/api/v1/yoIpn
# YO_FAILURE_URL=https://edge.solofx.net/api/v1/yoFailure

# Contribution receipt emails (existing SMTP mailer; optional tuning).
# SMTP_HOST=mail.saltmedia.ug
# SMTP_PORT=587
# SMTP_USER=no-reply@saltmedia.ug
# SMTP_PASS=...
# SMTP_FROM=no-reply@saltmedia.ug
# SMTP_FROM_NAME=Salt Media
# CONTRIBUTION_EMAIL_ENABLED=1
# CONTRIBUTION_EMAIL_INTERVAL_SECONDS=30
# CONTRIBUTION_EMAIL_LOOKBACK_HOURS=24
# CONTRIBUTION_EMAIL_LIMIT=200
# CONTRIBUTION_FALLBACK_EMAIL=info@saltmedia.ug
